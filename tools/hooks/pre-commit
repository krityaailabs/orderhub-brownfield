#!/usr/bin/env bash
# Git pre-commit hook for OrderHub Brownfield. Installed by `make install-hooks`.
# Runs only the checks the staged files need. Bypass with `git commit --no-verify` (and say why in review).
ROOT=$(git rev-parse --show-toplevel)
PY="$ROOT/.venv/bin/python"; [ -x "$PY" ] || PY=python3
exec "$PY" "$ROOT/tools/precommit.py"
