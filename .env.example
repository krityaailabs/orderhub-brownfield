# Copy to .env for local overrides. Never commit .env.
ORDERHUB_DATABASE_URL=sqlite:///./orderhub.db
ORDERHUB_CURRENCY=USD
ORDERHUB_BILLING_HANDOFF_DIR=./handoff
# Warehouse webhook (optional). The token comes from the warehouse team's secret store; never commit it.
ORDERHUB_WAREHOUSE_WEBHOOK_URL=
ORDERHUB_WAREHOUSE_TOKEN=
