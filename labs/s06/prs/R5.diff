diff --git a/services/orders/orderhub/notify.py b/services/orders/orderhub/notify.py
new file mode 100644
index 0000000..f785fcd
--- /dev/null
+++ b/services/orders/orderhub/notify.py
@@ -0,0 +1,10 @@
+"""Notify the warehouse system when an order is cancelled, so it can stop picking.
+
+Enabled when ORDERHUB_WAREHOUSE_WEBHOOK_URL is set. Retries transient failures."""
+
+
+def order_cancelled(url: str, order_id: int, lines: list[dict]) -> None:
+    import requests
+
+    body = {"event": "order.cancelled", "order_id": order_id, "lines": lines}
+    requests.post(url, json=body, timeout=5, retries=3)
diff --git a/services/orders/tests/test_notify.py b/services/orders/tests/test_notify.py
new file mode 100644
index 0000000..202a518
--- /dev/null
+++ b/services/orders/tests/test_notify.py
@@ -0,0 +1,29 @@
+import pytest
+from fastapi.testclient import TestClient
+
+from orderhub import notify, seed
+from orderhub.api import create_app
+from orderhub.config import Settings
+
+WEBHOOK = "https://warehouse.example/hooks/orderhub"
+
+
+@pytest.fixture
+def calls(monkeypatch):
+    recorded = []
+    monkeypatch.setattr(notify, "order_cancelled", lambda *args: recorded.append(args))
+    return recorded
+
+
+@pytest.fixture
+def hooked_client(tmp_path, calls):
+    app = create_app(Settings("sqlite://", "USD", str(tmp_path), WEBHOOK))
+    with app.state.session_factory() as session:
+        seed.load(session)
+    return TestClient(app)
+
+
+def test_cancel_notifies_the_warehouse(hooked_client, calls):
+    order = hooked_client.post("/orders", json={"customer_id": 1, "items": [{"sku": "MUG-350", "quantity": 2}]}).json()
+    assert hooked_client.post(f"/orders/{order['id']}/cancel").status_code == 200
+    assert calls == [(WEBHOOK, order["id"], [{"product_id": order["lines"][0]["product_id"], "quantity": 2}])]
