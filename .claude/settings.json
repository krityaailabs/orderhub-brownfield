{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "WebFetch"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/hooks/agent_after_edit.py"
          }
        ]
      }
    ]
  }
}
